# paging-mcp config
#
# APPRISE_URLS — newline OR semicolon OR comma separated list of Apprise URLs.
# Every URL is one channel paging-mcp will dispatch to. Mix freely.
#
# Full provider reference: https://github.com/caronc/apprise/wiki

APPRISE_URLS="
ntfys://ntfy.sh/<your-secret-topic-here>
"

# Optional examples (uncomment + fill in):
#
# WhatsApp Business via Whapi:
#   whapi+https://gate.whapi.cloud/messages/text?token=<TOKEN>&to=<+E164>
#
# Pushover (cheap reliable):
#   pover://<USER_KEY>@<APP_TOKEN>
#
# Telegram bot:
#   tgram://<BOT_TOKEN>/<CHAT_ID>
#
# Twilio SMS (still supported as one channel among many):
#   twilio://<ACCOUNT_SID>:<AUTH_TOKEN>@<FROM_NUMBER>/<TO_NUMBER>
#
# SMTP email:
#   mailto://<USER>:<PASS>@<SMTP_HOST>:<PORT>/?to=<DEST>
#
# AWS SNS:
#   sns://<ACCESS_KEY>/<ACCESS_SECRET>/<REGION>/<TOPIC>

# Log level — defaults to INFO.
PAGING_LOG_LEVEL=INFO
